# ── RefillKa Pilot · environment ──────────────────────────────
# Copy this file to `.env.local` and fill in from your Supabase project
# (Project Settings → Data API / API Keys). On Vercel, add the two
# NEXT_PUBLIC_* vars in Project Settings → Environment Variables.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server only — NEVER expose or commit. Used solely by scripts/seed-users.mjs
# to create the pilot test accounts. Do NOT add this to Vercel unless a
# server route needs it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
